SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8085

DB_URL='jdbc:mysql://localhost:3306/project_easy_translate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC'
DB_USERNAME=root
DB_PASSWORD=change_me

MONGO_URI='mongodb://root:change_me@localhost:27017/project_easy_translate?authSource=admin'

JWT_SECRET=ChangeThisDevSecretKeyAtLeast32Chars!!
JWT_EXPIRATION_MS=3600000
REFRESH_TOKEN_TTL_DAYS=30
CODE_RESEND_COOLDOWN_SECONDS=180
TRUST_FORWARDED_HEADERS=false
GOOGLE_OAUTH_CLIENT_IDS=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash-lite,gemini-1.5-flash-latest
GEMINI_API_VERSION=v1beta
FREE_DAILY_TOKEN_LIMIT=15000

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,exp://*

EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
PASSWORD_RESET_CODE_TTL_MINUTES=15
MAIL_ENABLED=false
MAIL_FROM=no-reply@talemind.app
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_SMTP_TIMEOUT_MS=5000
MAIL_SMTP_WRITE_TIMEOUT_MS=5000
MAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_CONNECT_TIMEOUT_MS=5000
RESEND_READ_TIMEOUT_MS=5000
MANAGEMENT_HEALTH_DB_ENABLED=true
MANAGEMENT_HEALTH_MONGO_ENABLED=false
